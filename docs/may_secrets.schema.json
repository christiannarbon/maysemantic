{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MaySecretsConfig",
  "type": "object",
  "required": [
    "auth_method",
    "mode"
  ],
  "properties": {
    "auth_method": {
      "$ref": "#/definitions/VaultAuthMethod"
    },
    "cache_ttl_secs": {
      "default": 300,
      "type": "integer",
      "format": "uint64",
      "minimum": 30.0
    },
    "mode": {
      "$ref": "#/definitions/SecretsMode"
    },
    "role_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "secret_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "token": {
      "type": [
        "string",
        "null"
      ]
    },
    "vault_address": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "vault_mount": {
      "default": "secret",
      "type": "string"
    }
  },
  "definitions": {
    "SecretsMode": {
      "type": "string",
      "enum": [
        "managed",
        "byov"
      ]
    },
    "VaultAuthMethod": {
      "type": "string",
      "enum": [
        "token",
        "approle"
      ]
    }
  }
}