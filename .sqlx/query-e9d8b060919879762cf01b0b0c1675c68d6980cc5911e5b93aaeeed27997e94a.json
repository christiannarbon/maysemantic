  "db_name": "PostgreSQL",
  "query": "\n            UPDATE users \n            SET \n                role = COALESCE($2::user_role, role),\n                password_hash = COALESCE($3::text, password_hash),\n                updated_at = now()\n            WHERE id = $1 AND is_active = true\n            RETURNING id, username, password_hash, role as \"role: Role\", is_active, created_at, updated_at\n            ",
